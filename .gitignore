# ---- 系统 / 编辑器 ----
.DS_Store
Thumbs.db
__pycache__/
*.pyc
*.pyo
.idea/
.vscode/

# ---- 数据缓存里体积大且无价值的 ----
# 音频文件是 B 站转写的中间产物，单个几 MB，转写完就没用了
tools/data/audio/
# 东财限流前的中间备份，已被 sector_daily.json 取代
tools/data/sector_daily_raw_backup.json
tools/data/_pending.json
# 抓取前的匆忙备份（*.bak_时间戳），只在本机回滚时有用
tools/data/*.bak_*
tools/data/*.bak
# 广度回填的断点续跑进度：纯本机用，Actions 走的是增量模式不需要它，
# 提交进去只会每天多一份 60KB 的变动噪音
tools/data/.breadth_state.json
# 催化归因的新闻语料缓存（几 MB）：只在调权重时 --reuse 用，不进仓库
tools/data/.news_cache.json

# ---- 凭据（绝对不要提交）----
# B 站 cookie（含 buvid3 等身份标识），用完即弃
tools/data/_bili_cookies.txt
# PushPlus token 等同推送权限，配置放在 ~/.market-calendar.push.json（仓库之外）
tools/.pushplus.json
.pushplus.json

# ---- 已废弃的输出目录（改用 docs/）----
dist/

# ---- 本机浏览器复测产物（截图，只给人眼看，不进仓库）----
tools/out/

# ---- 小程序私有配置 ----
miniprogram/project.private.config.json
